# ── Worker (server-side only) ───────────────────────────────────────────────
# Copy to apps/api/.dev.vars for local dev. In production set with `wrangler secret put`.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# mock | cashfree | signzy | digio | karza
PAN_PROVIDER=mock
PAN_API_URL=
PAN_API_KEY=

# ── Web (public, shipped to the browser) ────────────────────────────────────
# Copy to apps/web/.env.local
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
