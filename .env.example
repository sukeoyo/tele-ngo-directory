# Supabase — service role key is server-side only, never ship it to the browser
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (REST transport — the TCP client does not work on Workers)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PAN verification provider.
# Protean/NSDL has no open public API; access requires a bulk-verification
# agreement. In practice you go through an aggregator: Cashfree, Signzy,
# HyperVerge, Digio or Karza. Leave PAN_PROVIDER=mock to develop without one.
PAN_PROVIDER=mock
PAN_API_URL=
PAN_API_KEY=

# Public, safe to expose to the browser
VITE_API_URL=http://localhost:8787
